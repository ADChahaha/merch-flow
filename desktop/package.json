{
  "name": "merch-flow-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Electron 壳：内置 Python 后端（FastAPI + 前端 dist）的桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "EC_DESKTOP_URL=http://localhost:5173 electron .",
    "smoke": "EC_DESKTOP_SMOKE=1 electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.adchahaha.merchflow",
    "productName": "MerchFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "../backend/dist/merch-backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
